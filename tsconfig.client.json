{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "outDir": "./assets/js",
    "rootDir": "./assets/ts"
  },
  "include": ["assets/ts/**/*"],
  "exclude": ["node_modules"]
}
