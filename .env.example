NODE_ENV=development
PORT=4000
ELASTICSEARCH_URL=http://localhost:9200
MONGODB_URI=mongodb://localhost:27017/biscoon
JWT_SECRET=replace-with-a-long-random-secret
MSG_ENCRYPTION_KEY=replace-with-a-long-random-message-secret
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
APP_BASE_URL=http://localhost:4000
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Biscoon <noreply@biscoon.com>
UPLOAD_DIR=uploads
JSON_BODY_LIMIT=25mb
# Direct deployment: false. Behind a known single proxy: 1; or specify trusted IP/CIDR ranges.
TRUST_PROXY=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
