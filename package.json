{
  "name": "biscoon-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "check": "npm test && find . -type f -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n 1 node --check",
    "mongo": "mkdir -p data/mongo && mongod --dbpath data/mongo --bind_ip 127.0.0.1 --port 27017",
    "seed": "node seed.js",
    "migrate:conversations": "node scripts/migrate-conversations.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "uuid": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
