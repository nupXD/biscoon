{
  "name": "biscoon-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "dev": "nodemon --exec ts-node server.ts",
    "build": "tsc",
    "build:client": "npm run build:client:core && npm run build:client:plugins && npm run copy:vendor",
    "build:client:core": "esbuild assets/ts/biscoon.ts assets/ts/auth.ts assets/ts/admin.ts assets/ts/profile.ts assets/ts/ticker.ts --outdir=assets/js --target=es2020 --bundle=false --minify",
    "build:client:plugins": "esbuild assets/ts/plugins/*.ts --outdir=assets/js/plugins --target=es2020 --bundle --format=iife --platform=browser --minify",
    "copy:vendor": "mkdir -p assets/vendor/photoswipe assets/vendor/maplibre assets/vendor/swiper && cp node_modules/photoswipe/dist/photoswipe.css assets/vendor/photoswipe/photoswipe.css && cp node_modules/maplibre-gl/dist/maplibre-gl.css assets/vendor/maplibre/maplibre-gl.css && cp node_modules/swiper/swiper-bundle.min.js assets/vendor/swiper/swiper-bundle.min.js && cp node_modules/swiper/swiper-bundle.min.css assets/vendor/swiper/swiper-bundle.min.css",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "check": "npm test && npm run typecheck && npm run typecheck:client && npm run build:client",
    "mongo": "mkdir -p data/mongo && mongod --dbpath data/mongo --bind_ip 127.0.0.1 --port 27017",
    "seed": "ts-node seed.js",
    "reindex": "ts-node scripts/reindex-elasticsearch.js",
    "migrate:conversations": "ts-node scripts/migrate-conversations.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^7.17.14",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@sentry/browser": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "@tiptap/core": "^3.23.5",
    "@tiptap/extension-font-family": "^3.23.5",
    "@tiptap/extension-image": "^3.23.5",
    "@tiptap/extension-link": "^3.23.5",
    "@tiptap/extension-text-style": "^3.23.5",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "fuse.js": "^7.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "maplibre-gl": "^5.24.0",
    "mongoose": "^7.0.0",
    "nodemailer": "^9.0.5",
    "photoswipe": "^5.4.4",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swiper": "^12.1.4",
    "uuid": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
